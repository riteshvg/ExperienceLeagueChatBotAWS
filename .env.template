# LLM provider — which backend every LLM call site uses (see
# backend/core/llm_factory.py). Read once at startup, no code changes needed
# to switch. "anthropic" for local/dev, "bedrock" for deployed/production.
LLM_PROVIDER=anthropic

# Required if LLM_PROVIDER=anthropic (local/dev default)
ANTHROPIC_API_KEY=

# Required if LLM_PROVIDER=bedrock (production) — omit ANTHROPIC_API_KEY,
# provide AWS creds instead (see AWS / S3 section below for the same vars).
# BEDROCK_REGION=us-east-1

DATABASE_URL=postgresql://user:pass@localhost:5432/rovr

# Backend
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# Google OAuth (production sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# Admin panel
ADMIN_PASSWORD=
ADMIN_EMAIL=

# AWS / S3 (doc sync and Chroma backup)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=

# Optional
GITHUB_TOKEN=
LANGCHAIN_TRACING_V2=false
DAILY_QUERY_LIMIT=20
